<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny class library holding the contract (DTO + stream names) shared by the
       producer (Worker) and consumer (Alerter). Sharing the schema in one place is
       the idiomatic "both sides agree on the message contract" answer; neither
       service can drift from the other. No package dependencies on purpose. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SensorMon.Contracts</RootNamespace>
  </PropertyGroup>

</Project>
